# Ключ Helius (https://dashboard.helius.dev). Без ключа используется публичный RPC: медленно и неглубоко.
HELIUS_API_KEY=

# Необязательно. Свой RPC вместо публичного, если нет ключа Helius.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Необязательно. Порт сервера API (по умолчанию 8787).
# PORT=8787

# Необязательно. Запросов в секунду к Helius RPC (бесплатный тариф: 10, Developer: 50).
# HELIUS_RPS=8
